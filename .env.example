# 클라이언트에 노출되는 값 (이 두 개만)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=
# 3단계부터 사용
OPENAI_API_KEY=

# 이메일 인증 링크가 돌아올 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3단계: AI·안전
OPENAI_MODEL=gpt-4o-mini
# Vercel Cron 인증용 임의 문자열
CRON_SECRET=
# 위기 알림을 받을 웹훅 (Slack/Discord 등, 선택)
SAFETY_ALERT_WEBHOOK_URL=
# 마들랜 공식 링크 (출시 전 보건복지부 페이지에서 직접 확인)
NEXT_PUBLIC_MADLEN_URL=
